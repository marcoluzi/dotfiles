[submodule "dotbot"]
	path = dotbot
	url = https://github.com/anishathalye/dotbot
	ignore = dirty
[submodule "dotbot-brew"]
	path = dotbot-brew
	url = https://github.com/d12frosted/dotbot-brew.git
[submodule "dotbot-yay"]
	path = dotbot-yay
	url = https://github.com/OxSon/dotbot-yay.git
[submodule "tokyonight.nvim"]
	path = tokyonight.nvim
	url = https://github.com/folke/tokyonight.nvim.git
[submodule "kickstart.nvim"]
	path = kickstart.nvim
	url = https://github.com/marcoluzi/kickstart.nvim/
[submodule "ohmyzsh"]
	path = ohmyzsh
	url = https://github.com/ohmyzsh/ohmyzsh.git
[submodule "zsh-autosuggestions"]
	path = zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions.git
[submodule "zsh-completions"]
	path = zsh-completions
	url = https://github.com/zsh-users/zsh-completions.git
